{
  "manifest_version": 3,
  "name": "Codex Dev",
  "version": "1.6.0",
  "description": "Web design and dev toolkit: device mockups, design inspector, CSS editor, SEO audit, asset extractor and screenshots.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge/probes.js",
        "iframe-sync.js",
        "edit-mode.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "windows": "Alt+Shift+D",
        "mac": "Alt+Shift+D",
        "linux": "Alt+Shift+D"
      },
      "description": "Open Codex Dev"
    },
    "open-popular-mix": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "windows": "Alt+Shift+V",
        "mac": "Alt+Shift+V",
        "linux": "Alt+Shift+V"
      },
      "description": "Open this page in the Responsive Viewer with your Popular Mix"
    },
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "windows": "Alt+Shift+I",
        "mac": "Alt+Shift+I",
        "linux": "Alt+Shift+I"
      },
      "description": "Toggle the Design Inspector on the current page"
    }
  }
}
